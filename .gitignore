```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Build and distribution artifacts
build/
dist/
*.egg
*.egg-info/
*.so
*.whl

# Web specific
*.css.map
*.js.map
node_modules/

# Logs
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
.coverage
htmlcov/
.coverage.*
coverage.xml

# Testing
.pytest_cache/
.mypy_cache/
.hypothesis/
```